{
    "name": "alt-shift",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "start": "npm run dev",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "format": "npx prettier --write . && npx eslint --fix .",
        "preview": "vite preview",
        "create-icon-fonts": "rimraf ./public/icons/fonts/alt-shift* && fantasticon ./src/assets/icons -o ./public/icons/fonts/ -n alt-shift --normalize true --selector i -h 300 -t ttf woff woff2 -g html css",
        "prepare": "husky"
    },
    "dependencies": {
        "@tailwindcss/vite": "4.2.4",
        "classnames": "2.5.1",
        "openai": "6.34.0",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-hook-form": "7.74.0",
        "react-router-dom": "7.14.2",
        "tailwind-merge": "3.5.0",
        "tailwindcss": "4.2.4"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix --max-warnings 0",
            "prettier --write"
        ],
        "*.{css,json,md}": "prettier --write"
    },
    "devDependencies": {
        "@commitlint/cli": "20.5.2",
        "@commitlint/config-conventional": "20.5.0",
        "@eslint/js": "9.39.4",
        "@tailwindcss/language-server": "0.14.29",
        "@types/node": "24.12.2",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/eslint-plugin": "8.59.0",
        "@typescript-eslint/parser": "8.59.0",
        "@vitejs/plugin-react": "6.0.1",
        "eslint": "9.39.4",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.5",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.2",
        "fantasticon": "4.1.0",
        "globals": "17.5.0",
        "husky": "9.1.7",
        "lint-staged": "16.4.0",
        "prettier": "3.8.3",
        "rimraf": "6.1.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.59.0",
        "vite": "8.0.9",
        "vite-plugin-svgr": "5.2.0"
    }
}
